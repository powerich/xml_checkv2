{
  "name": "xml-unit-checker",
  "version": "1.0.0",
  "description": "XML 手册公英制单位批量检查工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourname.xmlunitchecker",
    "productName": "XML单位检查工具",
    "files": ["main.js", "preload.js", "index.html", "checker.js", "node_modules/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" }
  }
}
